@model IEnumerable<PortfolioMVC.Models.DTOs.ProductDto>

@{
    ViewData["Title"] = "Product Store";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4">Product Store</h1>
        <div>
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-controller="ShoppingCart" asp-action="Index" class="btn btn-outline-primary me-2">
                    <i class="bi bi-cart"></i> View Cart
                </a>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add Product
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Login to Shop
                </a>
            }
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow mb-4">
                <div class="card-header bg-light">
                    <h4 class="mb-0">Categories</h4>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-outline-primary">All Products</a>
                        @foreach (var category in Enum.GetValues(typeof(PortfolioMVC.Models.Enums.ProductCategory)))
                        {
                            <a href="#" class="btn btn-outline-secondary">@category</a>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header bg-light">
                    <h4 class="mb-0">Quick Links</h4>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-action="MyProducts" class="list-group-item list-group-item-action">
                                <i class="bi bi-person-circle"></i> My Products
                            </a>
                            <a asp-controller="Orders" asp-action="Index" class="list-group-item list-group-item-action">
                                <i class="bi bi-list-check"></i> My Orders
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="ManageProducts" class="list-group-item list-group-item-action">
                                    <i class="bi bi-gear"></i> Manage Products
                                </a>
                                <a asp-controller="Orders" asp-action="ManageOrders" class="list-group-item list-group-item-action">
                                    <i class="bi bi-clipboard-check"></i> Manage Orders
                                </a>
                            }
                        }
                        <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <p class="mb-0">No products available at the moment.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var product in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                @if (string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <div class="bg-light text-center py-5">
                                        <i class="bi bi-image text-secondary" style="font-size: 4rem;"></i>
                                    </div>
                                }
                                else
                                {
                                    <img src="@product.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@product.Name">
                                }
                                <div class="card-body">
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="card-text text-truncate">@product.Description</p>
                                    <p class="card-text text-primary fw-bold">$@product.Price.ToString("F2")</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-info text-dark">@product.Category</span>
                                        @if (product.IsAvailable)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unavailable</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-footer bg-white">
                                    <div class="d-grid gap-2">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                                        @if (User.Identity.IsAuthenticated && product.IsAvailable)
                                        {
                                            <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="btn btn-primary btn-sm w-100">
                                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>