@model PortfolioMVC.Models.DTOs.ProductDto

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-4">
    <h1 class="display-4 mb-4">Delete Product</h1>

    <div class="alert alert-danger mb-4">
        <h4 class="alert-heading">Warning!</h4>
        <p>Are you sure you want to delete this product? This action cannot be undone.</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h3 class="card-title mb-0">@Model.Name</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            @if (string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="bg-light text-center py-5 mb-3">
                                    <i class="bi bi-image text-secondary" style="font-size: 5rem;"></i>
                                </div>
                            }
                            else
                            {
                                <img src="@Model.ImageUrl" class="img-fluid mb-3" alt="@Model.Name">
                            }
                        </div>
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4">Name</dt>
                                <dd class="col-sm-8">@Model.Name</dd>

                                <dt class="col-sm-4">Price</dt>
                                <dd class="col-sm-8">$@Model.Price.ToString("F2")</dd>

                                <dt class="col-sm-4">Category</dt>
                                <dd class="col-sm-8">@Model.Category</dd>

                                <dt class="col-sm-4">Available</dt>
                                <dd class="col-sm-8">
                                    @if (Model.IsAvailable)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">No</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Approved</dt>
                                <dd class="col-sm-8">
                                    @if (Model.IsApproved)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </dd>
                            </dl>

                            <h5 class="mt-3">Description</h5>
                            <p>@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Confirm Deletion</h5>
                </div>
                <div class="card-body">
                    <p>Once you delete this product, it will be permanently removed from the system. This action cannot be undone.</p>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>