@model PortfolioMVC.Models.DTOs.OrderDto

@{
    ViewData["Title"] = "Order Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4">Order Details</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
    </div>

    <div class="row">
        <div class="col-md-4 order-md-2 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header bg-light">
                    <h3 class="mb-0">Order Summary</h3>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Order Number:</dt>
                        <dd class="col-sm-7">@Model.OrderNumber</dd>

                        <dt class="col-sm-5">Order Date:</dt>
                        <dd class="col-sm-7">@Model.OrderDate.ToString("MMM dd, yyyy")</dd>

                        <dt class="col-sm-5">Time:</dt>
                        <dd class="col-sm-7">@Model.OrderDate.ToString("HH:mm:ss")</dd>

                        <dt class="col-sm-5">Status:</dt>
                        <dd class="col-sm-7">
                            @{
                                var statusClass = Model.Status switch
                                {
                                    PortfolioMVC.Models.Enums.OrderStatus.Pending => "bg-warning",
                                    PortfolioMVC.Models.Enums.OrderStatus.Processing => "bg-primary",
                                    PortfolioMVC.Models.Enums.OrderStatus.Completed => "bg-success",
                                    PortfolioMVC.Models.Enums.OrderStatus.Cancelled => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass">@Model.Status</span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Total:</span>
                        <span class="fs-4 fw-bold">$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <a asp-controller="ProductsStore" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-cart"></i> Continue Shopping
                </a>
            </div>
        </div>

        <div class="col-md-8 order-md-1">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h3 class="mb-0">Order Items</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>$@item.Price.ToString("F2")</td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.TotalPrice.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="3" class="text-end">Total:</th>
                                    <th>$@Model.TotalAmount.ToString("F2")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>