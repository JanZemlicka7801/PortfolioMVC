@model PortfolioMVC.Controllers.Views.ExternalLoginConfirmationViewModel
@{
    ViewData["Title"] = "Complete Registration";
    var provider = ViewData["LoginProvider"] as string;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-info-circle me-3" style="font-size: 1.5rem;"></i>
                            <div>
                                <p class="mb-0">You've successfully authenticated with <strong>@provider</strong>.</p>
                                <p class="mb-0">Please provide a few more details to complete your registration.</p>
                            </div>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="ExternalLoginConfirmation" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <small class="text-muted">We've received this email from @provider. You can change it if needed.</small>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Full Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Your full name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Department" class="form-label">Department</label>
                            <select asp-for="Department" class="form-select" asp-items="Html.GetEnumSelectList<PortfolioMVC.Models.Enums.Department>()">
                                <option value="" selected disabled>Select a department</option>
                            </select>
                            <span asp-validation-for="Department" class="text-danger"></span>
                            <small class="text-muted">Please select which department you belong to.</small>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Complete Registration
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}