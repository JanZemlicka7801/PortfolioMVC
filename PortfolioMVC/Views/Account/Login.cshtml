@model PortfolioMVC.Controllers.Views.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container py-4">
    <h1 class="display-4 mb-4">@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4 mb-md-0">
                <div class="card-header bg-light">
                    <h3 class="mb-0">Sign in with email</h3>
                </div>
                <div class="card-body">
                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
                            </button>
                        </div>

                        <div class="mt-3 text-center">
                            <p>Don't have an account? <a asp-controller="Account" asp-action="Register" class="fw-bold">Register here</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h3 class="mb-0">Or sign in with</h3>
                </div>
                <div class="card-body">
                    <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="d-grid gap-3 p-2">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <button type="submit" name="provider" value="Microsoft" class="btn btn-outline-primary btn-lg d-flex align-items-center justify-content-center">
                            <i class="bi bi-microsoft me-3" style="font-size: 1.5rem;"></i> Sign in with Microsoft
                        </button>

                        <button type="submit" name="provider" value="Google" class="btn btn-outline-danger btn-lg d-flex align-items-center justify-content-center">
                            <i class="bi bi-google me-3" style="font-size: 1.5rem;"></i> Sign in with Google
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
